{
  "name": "kle-tech-grievance-management-platform",
  "version": "4.0.0",
  "description": "KLE Technological University - AI-Powered Centralized Grievance Management Platform",
  "scripts": {
    "dev": "node run-all.js",
    "start": "node run-all.js",
    "frontend": "npm --prefix complaint-system-v3-fixed/complaint-system-v3/frontend start",
    "backend": "cd complaint-system-v3-fixed/complaint-system-v3/backend && python -m uvicorn main:app --host 0.0.0.0 --port 5000",
    "migrate": "cd complaint-system-v3-fixed/complaint-system-v3/backend && python migrate_v4.py",
    "test-ai": "cd complaint-system-v3-fixed/complaint-system-v3/backend && python test_ai_features.py"
  }
}
